rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'apexworkwearportal@gmail.com' ||
        request.auth.token.email.matches('.*@apexworkwear\\.ca$') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Categories: Public read for storefront; Admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products: Public read for storefront; Admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings (fulfillment, pricing, apparelShipping, stripe): Public read; Admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Profiles: Owner can read/write their own document; Admin full access
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Orders: 
    // - Customers can read their own orders
    // - Authenticated users can create orders linked to their UID
    // - Admins can read and manage all orders
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.userId == null);
      allow update, delete: if isAdmin();
    }

    // Pending Orders (Proof approvals & admin queue): Admin access
    match /pendingOrders/{orderId} {
      allow read, write: if isAdmin();
    }

    // Carts: Customer manages their own cart
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Quotes: Public submission for custom quotes; Customer/Admin view
    match /quotes/{quoteId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Reviews: Public read; Authenticated user create/edit own review; Admin manage
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Sync Logs: Admin only
    match /syncLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
